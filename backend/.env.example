# Documentation only: export these variables in your shell or hosting provider.
# This file is not loaded automatically.
APP_ENV=development
SEED_DEMO=1
# APP_ENV=production disables demo seeding and requires a strong JWT_SECRET.
# JWT_SECRET=generate-a-unique-random-value-of-at-least-32-characters
# DB_PATH=/absolute/path/on/persistent/storage/appointments.sqlite3
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
